<UserControl
    x:Class="PlexLyricSync.PlayerControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Border
            x:Name="SongProgress"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Stretch"
            Margin="-16,14,-16,-16"
            Height="6"
            Background="#44FFFFFF"
            CornerRadius="3"
            PointerPressed="SongProgress_PointerPressed"
            PointerMoved="SongProgress_PointerMoved"
            PointerReleased="SongProgress_PointerReleased"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SongProgressScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="SongProgressTranslate"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border
                x:Name="SongProgressFill"
                Background="{ThemeResource SystemAccentColor}"
                HorizontalAlignment="Left"
                Width="0"/>
        </Border>

        <Grid
            x:Name="ControlsContainer"
            VerticalAlignment="Bottom"
            RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ControlsTranslate" />
            </Grid.RenderTransform>

            <Grid Margin="0 14 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="SettingsButton"
                    Grid.Column="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Height="40"
                    Width="40"
                    Click="SettingsButton_Click">
                    <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" Foreground="White"/>
                </Button>

                <StackPanel x:Name="Controls" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Grid.Column="1">
                    <Button
                        x:Name="PreviousButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Height="40"
                        Width="40"
                        Click="PreviousButton_Click">
                        <FontIcon x:Name="PreviousIcon" Glyph="&#xf8ac;" FontFamily="Segoe Fluent Icons" Foreground="White"/>
                    </Button>
                    <Button
                        x:Name="PlayPauseButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Height="40"
                        Width="40"
                        HorizontalAlignment="Center"
                        Click="PlayPauseButton_Click">
                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xf5b0;" FontFamily="Segoe Fluent Icons" Foreground="White"/>
                    </Button>
                    <Button
                        x:Name="NextButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Height="40"
                        Width="40"
                        Click="NextButton_Click">
                        <FontIcon x:Name="NextIcon" Glyph="&#xf8ad;" FontFamily="Segoe Fluent Icons" Foreground="White"/>
                    </Button>
                </StackPanel>

                <TextBlock
                    x:Name="TimeLabel"
                    Grid.ColumnSpan="3"
                    Foreground="#E6FFFFFF"
                    Opacity="0.9"
                    FontSize="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
