<UserControl
    x:Class="PlexLyricSync.PlayerControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel Grid.Row="2" Spacing="6">
        <StackPanel x:Name="Controls" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
            <Button
                x:Name="PreviousButton"
                Click="PreviousButton_Click">
                <SymbolIcon x:Name="PreviousIcon" Symbol="Previous"/>
            </Button>
            <Button
                x:Name="PlayPauseButton"
                Click="PlayPauseButton_Click"
                HorizontalAlignment="Center">
                <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play"/>
            </Button>
            <Button
                x:Name="NextButton"
                Click="NextButton_Click">
                <SymbolIcon x:Name="NextIcon" Symbol="Next"/>
            </Button>
        </StackPanel>
        <Border
            x:Name="SongProgress"
            Height="6"
            Background="#44FFFFFF"
            CornerRadius="3"
            PointerPressed="SongProgress_PointerPressed"
            PointerMoved="SongProgress_PointerMoved"
            PointerReleased="SongProgress_PointerReleased">
            <Border
                x:Name="SongProgressFill"
                Background="{ThemeResource SystemAccentColor}"
                HorizontalAlignment="Left"
                Width="0"/>
        </Border>
        <TextBlock
            x:Name="TimeLabel"
            Foreground="#E6FFFFFF"
            Opacity="0.9"
            FontSize="12"
            HorizontalAlignment="Right"
        />
    </StackPanel>
</UserControl>
