<UserControl
    x:Class="PlexLyricSync.PlayerControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid x:Name="ControlsContainer" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ControlsTranslate" />
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Progress bar above controls -->
            <Border
                x:Name="SongProgress"
                Grid.Row="0"
                Margin="0,0,0,6"
                Height="6"
                Background="#44FFFFFF"
                CornerRadius="3"
                PointerPressed="SongProgress_PointerPressed"
                PointerMoved="SongProgress_PointerMoved"
                PointerReleased="SongProgress_PointerReleased">
                <Border
                    x:Name="SongProgressFill"
                    Background="{ThemeResource SystemAccentColor}"
                    HorizontalAlignment="Left"
                    Width="0"/>
            </Border>

            <!-- Controls and time -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="Controls" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Grid.Column="1">
                    <Button
                        x:Name="PreviousButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="PreviousButton_Click">
                        <FontIcon x:Name="PreviousIcon" Glyph="&#xE892;" FontFamily="Segoe MDL2 Assets" Foreground="White"/>
                    </Button>
                    <Button
                        x:Name="PlayPauseButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="PlayPauseButton_Click"
                        HorizontalAlignment="Center">
                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" Foreground="White"/>
                    </Button>
                    <Button
                        x:Name="NextButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="NextButton_Click">
                        <FontIcon x:Name="NextIcon" Glyph="&#xE893;" FontFamily="Segoe MDL2 Assets" Foreground="White"/>
                    </Button>
                </StackPanel>

                <TextBlock
                    x:Name="TimeLabel"
                    Grid.ColumnSpan="3"
                    Foreground="#E6FFFFFF"
                    Opacity="0.9"
                    FontSize="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
