<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PlexLyricSync.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PlexLyricSync"
    Title="PlexLyricSync">


    <Grid Background="Transparent" PointerEntered="Window_PointerEntered" PointerExited="Window_PointerExited">
        <!-- Album art background -->
        <Image x:Name="AlbumArtImage" Stretch="UniformToFill" />

        <Grid Background="#CC111111">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="DragRegion" Grid.Row="0" Background="Transparent"/>

            <Grid x:Name="Root" x:FieldModifier="internal" Grid.Row="1" Padding="16 0 16 16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ArtistBlock/NowPlaying -->
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock
                        x:Name="ArtistBlock"
                        FontSize="14"
                        Text="{x:Bind NowPlaying.Text, Mode=OneWay}"
                    />
                    <TextBlock
                        x:Name="NowPlaying"
                        FontSize="18"
                        Foreground="White"
                        Text="Waiting for playback…"
                        TextWrapping="WrapWholeWords"
                    />
                </StackPanel>

                <!-- Lyrics and controls share the same row so lyrics stay centered -->
                <Grid Grid.Row="1">
                    <local:LyricsView x:Name="LyricsView" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    <local:PlayerControls x:Name="ControlPanel" VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</Window>
