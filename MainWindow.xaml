<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PlexLyricSync.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PlexLyricSync">


    <Grid Background="#CC111111">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="DragRegion" Grid.Row="0" Background="Transparent"/>

        <Grid x:Name="Root" Grid.Row="1" Padding="16 0 16 16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ArtistBlock/NowPlaying -->
            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock
               x:Name="ArtistBlock"
               FontSize="14"
               Text="{x:Bind NowPlaying.Text, Mode=OneWay}"
           />
                <TextBlock
               x:Name="NowPlaying"
               FontSize="18"
               Foreground="White"
               Text="Waiting for playback…"
               TextWrapping="WrapWholeWords"
           />
            </StackPanel>

            <!-- LyricLine -->
            <StackPanel  Grid.Row="1" x:Name="LyricStack" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="LyPrev3" FontSize="16" Foreground="White" Opacity="0.35" TextWrapping="WrapWholeWords" TextAlignment="Center"/>
                <TextBlock x:Name="LyPrev2" FontSize="18" Foreground="White" Opacity="0.45" TextWrapping="WrapWholeWords" TextAlignment="Center"/>
                <TextBlock x:Name="LyPrev1" FontSize="20" Foreground="White" Opacity="0.65" TextWrapping="WrapWholeWords" TextAlignment="Center"/>
                <TextBlock x:Name="LyCurr0" FontSize="28" Foreground="White" TextWrapping="WrapWholeWords" TextAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock x:Name="LyNext1" FontSize="22" Foreground="White" Opacity="0.80" TextWrapping="WrapWholeWords" TextAlignment="Center"/>
                <TextBlock x:Name="LyNext2" FontSize="18" Foreground="White" Opacity="0.55" TextWrapping="WrapWholeWords" TextAlignment="Center"/>
                <TextBlock x:Name="LyNext3" FontSize="16" Foreground="White" Opacity="0.35" TextWrapping="WrapWholeWords" TextAlignment="Center"/>
            </StackPanel>

            <!-- Controls/SongProgress/TimeLabel -->
            <StackPanel Grid.Row="2" Spacing="6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button x:Name="PrevButton" Content="⏮" Click="PrevButton_Click" />
                    <Button x:Name="NextButton" Content="⏭" Click="NextButton_Click" />
                </StackPanel>
                <ProgressBar
               x:Name="SongProgress"
               Height="6"
               Minimum="0"
               Maximum="100"
           />
                <TextBlock
               x:Name="TimeLabel"
               Foreground="#E6FFFFFF"
               Opacity="0.9"
               FontSize="12"
               HorizontalAlignment="Right"
           />
            </StackPanel>
        </Grid>
    </Grid>

</Window>