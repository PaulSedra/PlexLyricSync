<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PlexLyricSync.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PlexLyricSync"
    Title="PlexLyricSync">


    <Grid x:Name="BackgroundGrid" Background="#CC111111">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="DragRegion" Grid.Row="0" Background="Transparent"/>

        <Grid x:Name="Root" x:FieldModifier="internal" Grid.Row="1" Padding="16 0 16 16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ArtistBlock/NowPlaying -->
            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock
               x:Name="ArtistBlock"
               FontSize="14"
               Text="{x:Bind NowPlaying.Text, Mode=OneWay}"
           />
                <TextBlock
               x:Name="NowPlaying"
               FontSize="18"
               Foreground="White"
               Text="Waiting for playback…"
               TextWrapping="WrapWholeWords"
           />
            </StackPanel>

            <!-- Lyrics view -->
            <local:LyricsView Grid.Row="1" x:Name="LyricsView"/>

            <!-- Controls/SongProgress/TimeLabel -->
            <local:PlayerControls x:Name="ControlPanel" Grid.Row="2" />
        </Grid>
    </Grid>

</Window>