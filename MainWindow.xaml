<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PlexLyricSync.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PlexLyricSync"
    Title="PlexLyricSync">

    <Grid Background="Transparent" PointerEntered="Window_PointerEntered" PointerExited="Window_PointerExited" PointerMoved="Window_PointerMoved">
        <!-- Album art background -->
        <Image
            x:Name="AlbumArtImage"
            Stretch="UniformToFill"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <Grid Background="#CC111111">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="DragRegion" Grid.Row="0" Background="Transparent" HorizontalAlignment="Left" Width="520"/>

            <Grid x:Name="Root" x:FieldModifier="internal" Grid.Row="1" Margin="0 -14 0 0" Padding="16 0 16 16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ArtistBlock/NowPlaying -->
                <StackPanel Grid.Row="0" Spacing="2" HorizontalAlignment="Left" Width="300">
                    <TextBlock
                        x:Name="ArtistBlock"
                        FontSize="14"
                        Text=""/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            x:Name="NowPlaying"
                            FontSize="18"
                            Foreground="White"
                            Text="Waiting for playback…"
                            TextWrapping="WrapWholeWords"/>
                        <Button x:Name="FavoriteButton" Style="{StaticResource FavoriteTrackButton}" Click="FavoriteButton_Click">
                            <Grid x:Name="FavRoot" Width="30" Height="30" Background="Transparent">

                                <FontIcon x:Name="FavoriteIcon"
                                          Glyph="&#xEB52;"
                                          FontFamily="Segoe Fluent Icons"
                                          Foreground="Pink"
                                          FontSize="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Opacity="1"/>

                                <Canvas x:Name="Burst"
                                        Opacity="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="30" Height="30"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Canvas.RenderTransform>
                                        <ScaleTransform x:Name="BurstScale" ScaleX="0.6" ScaleY="0.6"/>
                                    </Canvas.RenderTransform>

                                    <!-- 6 little circles around -->
                                    <Ellipse Width="4" Height="4" Fill="Pink" Canvas.Left="13" Canvas.Top="0"/>
                                    <Ellipse Width="4" Height="4" Fill="Pink" Canvas.Left="23" Canvas.Top="5"/>
                                    <Ellipse Width="4" Height="4" Fill="Pink" Canvas.Left="26" Canvas.Top="14"/>
                                    <Ellipse Width="4" Height="4" Fill="Pink" Canvas.Left="23" Canvas.Top="23"/>
                                    <Ellipse Width="4" Height="4" Fill="Pink" Canvas.Left="13" Canvas.Top="26"/>
                                    <Ellipse Width="4" Height="4" Fill="Pink" Canvas.Left="0"  Canvas.Top="14"/>
                                </Canvas>

                                <Grid.Resources>
                                    <Storyboard x:Name="UnfavoriteExplosion">

                                        <!-- Glyph changes -->
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="FavoriteIcon"
                                            Storyboard.TargetProperty="Glyph">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.00" Value="&#xEA92;"/> <!-- broken -->
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.30" Value="&#xEB51;"/> <!-- outline -->
                                        </ObjectAnimationUsingKeyFrames>

                                        <!-- Heart opacity -->
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="FavoriteIcon"
                                            Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.00" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.29" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.50" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>

                                        <!-- Burst opacity -->
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="Burst"
                                            Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="1"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.30" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>

                                        <!-- Burst scale X -->
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="BurstScale"
                                            Storyboard.TargetProperty="ScaleX">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.00" Value="0.6"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="1.6"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.30" Value="0.6"/>
                                        </DoubleAnimationUsingKeyFrames>

                                        <!-- Burst scale Y -->
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="BurstScale"
                                            Storyboard.TargetProperty="ScaleY">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.00" Value="0.6"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="1.6"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.30" Value="0.6"/>
                                        </DoubleAnimationUsingKeyFrames>

                                    </Storyboard>

                                </Grid.Resources>
                            </Grid>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1">
                    <local:LyricsView x:Name="LyricsView" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    <local:PlayerControls x:Name="ControlPanel" VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>

            <Frame x:Name="SettingsFrame" Grid.Row="1" Margin="0 -30 0 0" Padding="0" Visibility="Collapsed"/>
        </Grid>
    </Grid>

</Window>
