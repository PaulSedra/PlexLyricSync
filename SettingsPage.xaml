<Page
    x:Class="PlexLyricSync.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PlexLyricSync"
    Background="Gray">
    <Grid Padding="20">
        <TabView IsAddTabButtonVisible="False" TabStripMargin="0">
            <TabView.Resources>
                <CornerRadius x:Key="TabViewItemHeaderCornerRadius">0</CornerRadius>
            </TabView.Resources>
            <TabViewItem Header="Plex" IsClosable="False">
                <StackPanel Spacing="12">
                    <TextBox x:Name="PlexUrlBox" Header="Plex URL" TextChanged="SettingChanged"/>
                    <TextBox x:Name="PlexTokenBox" Header="Plex Token" TextChanged="SettingChanged"/>
                    <Button Content="Back" HorizontalAlignment="Right" Click="BackButton_Click"/>
                </StackPanel>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
