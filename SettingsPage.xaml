<Page
    x:Class="PlexLyricSync.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PlexLyricSync">
    <Grid Padding="20">
        <TabView>
            <TabViewItem Header="Plex">
                <StackPanel Spacing="12">
                    <TextBox x:Name="PlexUrlBox" Header="Plex URL"/>
                    <TextBox x:Name="PlexTokenBox" Header="Plex Token"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Save" Click="SaveButton_Click"/>
                        <Button Content="Back" Click="BackButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
